@value px1 from "$nissy-girl/nissy-girl.mcss";
@value depth from "$nissy-girl/nissy-girl.mcss";

.dpad {
	--rotate-x: 0deg;
	--rotate-y: 0deg;

	composes: touchinteractive, animates from "$util/util.mcss";

	position: absolute;
	bottom: calc(59.5 * px1);
	left: calc(9.25 * px1);
	transform-origin: center center 4px;
	transform-style: preserve-3d;
	transform: translateZ(var(--button-plane));

	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;

	/* aspect ratio: 31 / 30 (safari doesnt like aspect ratio here so precalc it..) */
	width: calc(31 * px1);
	height: calc(32 * px1);
}

.dpadface {
	composes: face from "$util/util.mcss";
	width: calc(29 * px1);
	height: calc(30 * px1);
	background-image: url("./assets/dpad.png");
}

.dpadbackface {
	composes: face from "$util/util.mcss";

	position: absolute;
	inset: 0;
	transform: translateZ(-1px);

	width: 96%;
	height: 94%;
	margin: auto;

	background-image: url("./assets/dpad-backface.png");
}

.dpadcenterside {
	composes: face from "$util/util.mcss";

	position: absolute;
	top: (px1 * 0.6);
	bottom: 0;
	left: 0;
	transform: rotateY(-90deg) translateX(-56%) translateZ(calc(-12 * px1));

	aspect-ratio: 5 / 32;
	height: calc(31 * px1);

	background-image: url("./assets/dpad-side.png");

	&[data-left="true"] {
		right: 0;
		left: auto;
		transform: rotateY(90deg) translateX(56%) translateZ(calc(-12 * px1));
	}
}
