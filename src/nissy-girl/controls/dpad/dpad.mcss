@value depth from "$nissy-girl/nissy-girl.mcss";

@value xlate: 0.6rem;
@value halfxlate: calc(xlate * 0.5);

@value dpadhousingpadding: 2rem;
@value dpadhousingbg: 53rem;
@value dpadhousingsize: calc(dpadhousingpadding + dpadhousingbg);

@value deadzonepadding: 16rem;
@value deadzonesize: calc(dpadhousingsize + deadzonepadding);

.deadzone {
	composes: touchinteractive from "$util/util.mcss";

	position: absolute;
	bottom: 40rem;
	left: 1rem;
	transform-style: preserve-3d;

	width: deadzonesize;
	height: deadzonesize;
	margin: auto;
	border-radius: 50%;
}

.interactive {
	composes: touchinteractive from "$util/util.mcss";

	position: absolute;
	inset: 0;
	transform-style: preserve-3d;

	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;

	width: dpadhousingsize;
	height: dpadhousingsize;
	margin: auto;
	border-radius: 50%;
}

.housing {
	composes: face from "$util/util.mcss";

	position: absolute;
	inset: 0;
	transform-style: preserve-3d;
	transform: translateZ(-3px);

	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;

	width: dpadhousingbg;
	height: dpadhousingbg;
	margin: auto;

	background-image: url("./assets/dpad-housing.png");
	background-position: 50% 50%;
}

.dpad {
	--xlate: xlate;
	--halfxlate: halfxlate;

	composes: animates from "$util/util.mcss";

	pointer-events: none;

	transform-origin: center center 4px;
	transform-style: preserve-3d;
	transform: translateZ(var(--button-plane));

	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;

	width: 37rem;
	height: 37rem;
	margin-top: 0.5rem;
}

.dpadface {
	composes: face, animates from "$util/util.mcss";

	transform-origin: center center 4px;

	width: 30rem;
	height: 31rem;

	background-image: url("./assets/dpad.png");
}

.dpadbackface {
	composes: face, animates from "$util/util.mcss";

	position: absolute;
	inset: 0;
	transform-origin: center center 4px;
	transform: translateZ(-1px);

	aspect-ratio: 33 / 32;
	width: 31rem;
	margin: auto;

	background-image: url("./assets/dpad-backface.png");
}

.dpadcenterside {
	composes: face from "$util/util.mcss";

	position: absolute;
	top: 3rem;
	bottom: 0;
	left: 0;
	transform: rotateY(-90deg) translateX(-52%) translateZ(-13rem);

	aspect-ratio: 5 / 32;
	height: 31rem;

	background-image: url("./assets/dpad-side.png");

	&[data-left="true"] {
		right: 0;
		left: auto;
		transform: rotateY(90deg) translateX(50%) translateZ(-13rem);
	}
}
