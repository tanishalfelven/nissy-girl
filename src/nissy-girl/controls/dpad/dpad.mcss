@value px1 from "$nissy-girl/nissy-girl.mcss";
@value depth from "$nissy-girl/nissy-girl.mcss";

@value xlate: calc(px1 * 0.6);
@value halfxlate: calc(xlate * 0.5);

.deadzone {
	composes: touchinteractive from "$util/util.mcss";

	position: absolute;
	bottom: calc(41 * px1);
	left: calc(3 * px1);
	transform-style: preserve-3d;

	width: calc(66 * px1);
	height: calc(66 * px1);
	margin: auto;
	border-radius: 50%;
}

.housing {
	composes: touchinteractive from "$util/util.mcss";

	position: absolute;
	inset: 0;
	transform-style: preserve-3d;

	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;

	width: calc(51 * px1);
	height: calc(51 * px1);
	margin: auto;
	border-radius: 50%;

	&::after {
		pointer-events: none;
		content: " ";

		position: absolute;
		inset: 0;

		width: calc(49 * px1);
		height: calc(49 * px1);
		margin: auto;

		background-image: url("./assets/dpad-housing.png");
		background-repeat: no-repeat;
		background-position: 50% 50%;
		background-size: calc(49 * px1) calc(49 * px1);
	}
}

.dpad {
	--xlate: xlate;
	--halfxlate: halfxlate;

	composes: animates from "$util/util.mcss";

	pointer-events: none;

	transform-origin: center center 4px;
	transform-style: preserve-3d;
	transform: translateZ(var(--button-plane));

	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;

	width: calc(36 * px1);
	height: calc(36 * px1);
}

.dpadface {
	composes: face, animates from "$util/util.mcss";

	transform-origin: center center 4px;

	width: calc(30 * px1);
	height: calc(29.5 * px1);

	background-image: url("./assets/dpad.png");
}

.dpadbackface {
	composes: face, animates from "$util/util.mcss";

	position: absolute;
	inset: 0;
	transform-origin: center center 4px;
	transform: translateZ(-1px);

	aspect-ratio: 33 / 32;
	width: calc(31 * px1);
	margin: auto;

	background-image: url("./assets/dpad-backface.png");
}

.dpadcenterside {
	composes: face from "$util/util.mcss";

	position: absolute;
	top: calc(3.2 * px1);
	bottom: 0;
	left: 0;
	transform: rotateY(-90deg) translateX(-52%) translateZ(calc(-13 * px1));

	aspect-ratio: 5 / 32;
	height: calc(29.5 * px1);

	background-image: url("./assets/dpad-side.png");

	&[data-left="true"] {
		right: 0;
		left: auto;
		transform: rotateY(90deg) translateX(50%) translateZ(calc(-13 * px1));
	}
}
