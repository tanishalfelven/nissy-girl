@value px1 from "$nissy-girl/nissy-girl.mcss";
@value depth from "$nissy-girl/nissy-girl.mcss";

.dpad {
	--rotate-x: 0deg;
	--rotate-y: 0deg;

	composes: touchinteractive, animates from "$util/util.mcss";

	position: absolute;
	bottom: calc(46 * px1);
	left: calc(9.2 * px1);
	transform-origin: center center 4px;
	transform-style: preserve-3d;
	transform: translateZ(var(--button-plane));

	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;

	width: calc(43 * px1);
	height: calc(46 * px1);
}

.dpadface {
	composes: face from "$util/util.mcss";
	aspect-ratio: 1 / 1;
	height: 95%;
	background-image: url("./assets/dpad.png");
}

.dpadbackface {
	composes: face from "$util/util.mcss";

	position: absolute;
	inset: 0;
	transform: translateZ(-2px);

	aspect-ratio: 43 / 44;
	width: calc(43 * px1);
	margin: auto;

	background-image: url("./assets/dpad-backface.png");
}

.dpadcenterside {
	composes: face from "$util/util.mcss";

	position: absolute;
	top: calc(0.5 * px1);
	bottom: 0;
	left: 0;
	transform: rotateY(-90deg) translateX(-58%) translateZ(calc(-14 * px1));

	aspect-ratio: 5 / 44;
	height: calc(44 * px1);

	background-image: url("./assets/dpad-side.png");

	&[data-left="true"] {
		right: 0;
		left: auto;
		transform: rotateY(90deg) translateX(58%) translateZ(calc(-14 * px1));
	}
}
