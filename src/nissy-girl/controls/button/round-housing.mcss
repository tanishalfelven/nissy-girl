@value px1 from "$nissy-girl/nissy-girl.mcss";
@value deadzonesize from "$nissy-girl/controls/dpad/dpad.mcss";

@value facebuttondeadzoneheight: calc(deadzonesize * 0.66);

.deadzone {
	composes: touchinteractive from "$util/util.mcss";

	position: absolute;
	right: calc(2 * px1);
	bottom: calc(50 * px1);
	transform-style: preserve-3d;

	/* pixel offset helps make sure deadzone always is hit by mouse */
	transform: rotate(-30deg) translateZ(1px);

	width: calc(deadzonesize * px1);
	height: calc(facebuttondeadzoneheight * px1);
	margin: auto;
	border-radius: calc(15 * px1);
}

.unrotate {
	transform-style: preserve-3d;
	transform: rotate(30deg);
}

.housing {
	composes: face from "$util/util.mcss";

	position: absolute;
	right: calc(4 * px1);
	bottom: calc(-1 * px1);
	transform-style: preserve-3d;
	transform: rotate(30deg) translateZ(-4px);

	width: calc(60 * px1);
	height: calc(52 * px1);

	background-image: url("./assets/ab-housing.png");
}
