.button {
	composes: touchinteractive from "$util/util.mcss";
	position: absolute;
	transform-style: preserve-3d;

	&[data-type="round"] {
		display: flex;
		align-items: center;
		justify-content: center;

		width: 28.7rem;
		height: 28.7rem;
		border-radius: 50%;

		&[data-button="BUTTON_A"] {
			right: -3rem;
			bottom: -24.5rem;
		}

		&[data-button="BUTTON_B"] {
			bottom: -40.5rem;
			left: 21rem;
		}
	}

	&[data-type="bean"] {
		bottom: 10rem;

		display: flex;
		align-items: center;
		justify-content: center;

		width: 22rem;
		height: 14rem;

		&[data-button="START"] {
			right: 46rem;
		}

		&[data-button="SELECT"] {
			left: 45rem;
		}
	}
}

.face {
	composes: face, backface, animates from "$util/util.mcss";
	pointer-events: none;

	&[data-type="round"] {
		position: absolute;
		transform-style: preserve-3d;
		width: 18rem;
		height: 18rem;

		&::after {
			transform: translateY(0.5px) translateZ(-1px);
			width: 100%;
			height: 100%;
		}

		&[data-button="BUTTON_A"] {
			background-image: url("./assets/button-a.png");

			&::after {
				background-image: url("./assets/button-a-inner.png");
			}
		}

		&[data-button="BUTTON_B"] {
			background-image: url("./assets/button-b.png");

			&::after {
				background-image: url("./assets/button-b-inner.png");
			}
		}
	}

	&[data-type="bean"] {
		position: absolute;
		top: 1rem;

		width: 17rem;

		/* safari prefers this as strict height... */
		height: 5rem;

		background-image: url("./assets/button-bean.png");
	}
}

.beanside {
	composes: face, backface from "$util/util.mcss";

	position: absolute;
	left: 2rem;
	transform: rotateY(-90deg) translateX(-50%);

	width: 3rem;
	height: 5rem;
	margin: auto;

	&::after {
		width: 100%;
		height: 100%;
		background-image: url("./assets/button-bean-side.png");
	}

	&[data-right="true"] {
		right: 2rem;
		left: auto;
		transform: rotateY(90deg) translateX(50%);
	}
}

.roundside {
	composes: face, backface from "$util/util.mcss";
	transform: rotateY(90deg) translateX(60%) translateZ(8rem);
	width: 6rem;
	height: 18rem;

	&::after {
		transform: translateZ(-3rem);
		width: 100%;
		height: 100%;
		background-image: url("./assets/button-round-side.png");
	}
}
