@value px1 from "$nissy-girl/nissy-girl.mcss";

.button {
	composes: face, backface, touchinteractive, animates from "$util/util.mcss";
	box-sizing: content-box;
	padding: calc(2 * px1);
	background-origin: content-box;

	&[data-type="round"] {
		position: absolute;
		transform-style: preserve-3d;

		width: calc(18 * px1);
		height: calc(18 * px1);
		padding: calc(5 * px1);

		&::after {
			transform: translateY(0.5px) translateZ(-1px);
			width: 100%;
			height: 100%;
		}

		&[data-button="BUTTON_A"] {
			right: calc(8 * px1);
			bottom: calc(65 * px1);
			padding-left: calc(3.5 * px1) !important;
			background-image: url("./assets/button-a.png");

			&::after {
				background-image: url("./assets/button-a-inner.png");
			}
		}

		&[data-button="BUTTON_B"] {
			right: calc(34.5 * px1);
			bottom: calc(54 * px1);
			padding-right: calc(3.5 * px1) !important;
			background-image: url("./assets/button-b.png");

			&::after {
				background-image: url("./assets/button-b-inner.png");
			}
		}
	}

	&[data-type="bean"] {
		position: absolute;
		bottom: calc(10 * px1);
		transform-style: preserve-3d;

		width: calc(17 * px1);

		/* safari prefers this as strict height... */
		height: calc(5 * px1);
		padding-bottom: calc(8 * px1);

		background-image: url("./assets/button-bean.png");

		&[data-button="START"] {
			right: calc(47 * px1);
		}

		&[data-button="SELECT"] {
			left: calc(45 * px1);
		}
	}
}

.beanside {
	composes: face, backface from "$util/util.mcss";

	position: absolute;
	top: calc(2 * px1);
	left: calc(2 * px1);
	transform: rotateY(-90deg) translateX(-50%);

	width: calc(3 * px1);
	height: calc(5 * px1);
	margin: auto;

	&::after {
		width: 100%;
		height: 100%;
		background-image: url("./assets/button-bean-side.png");
	}

	&[data-right="true"] {
		right: calc(2 * px1);
		left: auto;
		transform: rotateY(90deg) translateX(50%);
	}
}

.roundside {
	composes: face, backface from "$util/util.mcss";
	transform: rotateY(90deg) translateX(56%) translateZ(calc(8 * px1));
	width: calc(6 * px1);
	height: calc(18 * px1);

	&::after {
		transform: translateZ(calc(-3 * px1));
		width: 100%;
		height: 100%;
		background-image: url("./assets/button-round-side.png");
	}
}
