@value px1 from "$nissy-girl/nissy-girl.mcss";

.button {
	composes: touchinteractive from "$util/util.mcss";
	position: absolute;
	transform-style: preserve-3d;

	&[data-type="round"] {
		display: flex;
		align-items: center;
		justify-content: center;

		width: calc(28.7 * px1);
		height: calc(28.7 * px1);
		border-radius: 50%;

		&[data-button="BUTTON_A"] {
			right: calc(-3 * px1);
			bottom: calc(-24.5 * px1);
		}

		&[data-button="BUTTON_B"] {
			bottom: calc(-40.5 * px1);
			left: calc(21 * px1);
		}
	}

	&[data-type="bean"] {
		bottom: calc(10 * px1);

		display: flex;
		align-items: center;
		justify-content: center;

		width: calc(22 * px1);
		height: calc(14 * px1);

		&[data-button="START"] {
			right: calc(46 * px1);
		}

		&[data-button="SELECT"] {
			left: calc(45 * px1);
		}
	}
}

.face {
	composes: face, backface, animates from "$util/util.mcss";
	pointer-events: none;

	&[data-type="round"] {
		position: absolute;
		transform-style: preserve-3d;
		width: calc(18 * px1);
		height: calc(18 * px1);

		&::after {
			transform: translateY(0.5px) translateZ(-1px);
			width: 100%;
			height: 100%;
		}

		&[data-button="BUTTON_A"] {
			background-image: url("./assets/button-a.png");

			&::after {
				background-image: url("./assets/button-a-inner.png");
			}
		}

		&[data-button="BUTTON_B"] {
			background-image: url("./assets/button-b.png");

			&::after {
				background-image: url("./assets/button-b-inner.png");
			}
		}
	}

	&[data-type="bean"] {
		position: absolute;
		top: px1;

		width: calc(17 * px1);

		/* safari prefers this as strict height... */
		height: calc(5 * px1);

		background-image: url("./assets/button-bean.png");
	}
}

.beanside {
	composes: face, backface from "$util/util.mcss";

	position: absolute;
	left: calc(2 * px1);
	transform: rotateY(-90deg) translateX(-50%);

	width: calc(3 * px1);
	height: calc(5 * px1);
	margin: auto;

	&::after {
		width: 100%;
		height: 100%;
		background-image: url("./assets/button-bean-side.png");
	}

	&[data-right="true"] {
		right: calc(2 * px1);
		left: auto;
		transform: rotateY(90deg) translateX(50%);
	}
}

.roundside {
	composes: face, backface from "$util/util.mcss";
	transform: rotateY(90deg) translateX(60%) translateZ(calc(8 * px1));
	width: calc(6 * px1);
	height: calc(18 * px1);

	&::after {
		transform: translateZ(calc(-3 * px1));
		width: 100%;
		height: 100%;
		background-image: url("./assets/button-round-side.png");
	}
}
