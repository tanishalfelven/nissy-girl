@value px1 from "$nissy-girl/nissy-girl.mcss";

@value switchdepth: calc(4 * px1);
@value hitpadding: calc(3 * px1);

.housing {
	composes: face, touchinteractive from "$util/util.mcss";

	will-change: auto;

	position: absolute;
	top: calc(46 * px1);
	left: 23%;
	transform-style: preserve-3d;

	/* I am fighting my demons, right here */
	transform: translateX(calc(1vh * 0.07));

	width: calc(13 * px1);
	height: calc(44 * px1);

	background-image: url("./assets/housing.png");
}

.powerswitch {
	--position: 0%;

	composes: face from "$util/util.mcss";

	position: absolute;

	aspect-ratio: 5 / 24;
	width: calc(4 * px1);
	padding: hitpadding;

	background-image: url("./assets/power-switch-side.png");

	&[data-top="true"] {
		top: calc(-2 * px1);
		left: calc(-2.5 * px1);
		transform-style: preserve-3d;
		transform:
			translateZ(switchdepth)
			translateY(var(--position))
			scale(0.9);

		box-sizing: content-box;

		background-image: url("./assets/power-switch-top.png");
		background-origin: content-box;

		transition: transform 300ms ease-in-out;
	}

	&[data-left="true"],
	&[data-right="true"] {
		width: switchdepth;
		padding: 0;
		backface-visibility: visible;
	}

	&[data-left="true"] {
		left: auto;
		transform:
			translateX(-50%)
			rotateY(-90deg)
			translateX(-50%);
	}

	&[data-right="true"] {
		right: auto;
		transform:
			translateX(50%)
			rotateY(90deg)
			translateX(50%);
	}

	&[data-willtoggle="true"] {
		--position: 10%;
	}

	&[data-power="false"] {
		--position: 92%;
	}

	&[data-power="false"][data-willtoggle="true"] {
		--position: 55%;
	}
}
