.housing {
	composes: face, touchinteractive from "$util/util.mcss";

	position: absolute;
	top: 46rem;
	left: 10.98rem;
	transform-style: preserve-3d;

	width: 13rem;
	height: 44rem;

	background-image: url("./assets/housing.png");
}

.powerswitch {
	--position: 8%;

	composes: face from "$util/util.mcss";

	position: absolute;
	transform-style: preserve-3d;

	aspect-ratio: 5 / 20;
	width: 5rem;

	&[data-willtoggle="true"] {
		--position: 10%;
	}

	&[data-power="false"] {
		--position: 110%;
	}

	&[data-power="false"][data-willtoggle="true"] {
		--position: 84%;
	}
}

.powerback {
	composes: powerswitch;

	position: relative;
	top: 0;
	left: 0.15rem;
	transform-style: preserve-3d;
	transform:
		translateY(var(--position))
		scale(0.9);

	background-image: url("./assets/power-backface.png");

	transition: transform 700ms linear(0, 0.837 15.2%, 1.053 23.6%, 1);
}

.middle {
	composes: powerswitch;
	transform: translateX(0.2rem) translateZ(2.5rem);
	background-image: url("./assets/power-face-middle.png");
}

.face {
	composes: powerswitch;
	transform-style: flat;
	transform: translateZ(0.5rem);
	background-image: url("./assets/power-face.png");
}

.innerside {
	composes: face, backface from "$util/util.mcss";

	position: absolute;
	transform: rotateY(-90deg) translateZ(2.05rem);

	width: 6rem;
	height: 20rem;

	background-image: url("./assets/power-inner-side.png");

	&::after {
		transform: rotate(180deg) translateZ(-0.3rem);
		width: 100%;
		height: 100%;
		background-image: url("./assets/power-face-inner-back.png");
	}
}

.innersideright {
	composes: innerside;

	transform: scaleX(-1) rotateY(-90deg) translateX(11%) translateZ(1.7rem);

	width: 100%;
	height: 100%;

	background-image: url("./assets/power-inner-side.png");

	&::after {
		transform: rotate(180deg) translateZ(-0.1rem);
	}
}
