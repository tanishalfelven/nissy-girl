@value px1 from "$nissy-girl/nissy-girl.mcss";

.housing {
	composes: face, touchinteractive from "$util/util.mcss";

	position: absolute;
	top: calc(46 * px1);
	left: 23%;
	transform-style: preserve-3d;

	/* I am fighting my demons, right here */
	transform: translateX(calc(1vh * 0.07));

	width: calc(13 * px1);
	height: calc(44 * px1);

	background-image: url("./assets/housing.png");
}

.powerswitch {
	--position: 8%;

	composes: face from "$util/util.mcss";

	position: absolute;
	transform-style: preserve-3d;

	aspect-ratio: 5 / 20;
	width: calc(5 * px1);

	&[data-willtoggle="true"] {
		--position: 10%;
	}

	&[data-power="false"] {
		--position: 110%;
	}

	&[data-power="false"][data-willtoggle="true"] {
		--position: 84%;
	}
}

.powerback {
	composes: powerswitch;

	position: relative;
	top: calc(0 * px1);
	left: calc(0.15 * px1);
	transform-style: preserve-3d;
	transform:
		translateY(var(--position))
		scale(0.9);

	background-image: url("./assets/power-backface.png");

	transition: transform 700ms linear(0, 0.837 15.2%, 1.053 23.6%, 1);
}

.middle {
	composes: powerswitch;
	transform: translateX(calc(0.2 * px1)) translateZ(calc(2.5 * px1));
	background-image: url("./assets/power-face-middle.png");
}

.face {
	composes: powerswitch;
	transform-style: flat;
	transform: translateZ(calc(0.5 * px1));
	background-image: url("./assets/power-face.png");
}

.innerside {
	composes: face, backface from "$util/util.mcss";

	position: absolute;
	transform: rotateY(-90deg) translateZ(calc(2.05 * px1));

	width: calc(6 * px1);
	height: calc(20 * px1);

	background-image: url("./assets/power-inner-side.png");

	&::after {
		transform: rotate(180deg) translateZ(calc(-0.3 * px1));
		width: 100%;
		height: 100%;
		background-image: url("./assets/power-face-inner-back.png");
	}
}

.innersideright {
	composes: innerside;

	transform: scaleX(-1) rotateY(-90deg) translateX(11%) translateZ(calc(1.7 * px1));

	width: 100%;
	height: 100%;

	background-image: url("./assets/power-inner-side.png");

	&::after {
		transform: rotate(180deg) translateZ(calc(-0.1 * px1));
	}
}
