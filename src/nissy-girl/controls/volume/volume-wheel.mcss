.housing {
	composes: face, touchinteractive, animates from "$util/util.mcss";

	bottom: 28rem;
	left: 4rem;
	transform-style: preserve-3d;
	transform: rotate(180deg) scaleX(-1);

	width: 12rem;
	height: 22rem;

	background-image: url("./assets/housing.png");
}

.wheel {
	composes: face, backface from "$util/util.mcss";

	bottom: 2rem;

	width: 18rem;
	height: 18rem;

	background-image: url("./assets/wheel-outer.png");

	&::after {
		width: 18rem;
		height: 18rem;
		background-image: url("./assets/wheel-inner.png");
	}

	&[data-back="true"] {
		transform: rotateY(90deg) translateX(20%) rotateZ(var(--rotation));

		&::after {
			transform: rotateY(180deg) translateZ(0.1px);
		}
	}

	&[data-front="true"] {
		left: -1rem;
		transform: rotateY(-90deg) translateX(-20%) scaleX(-1) rotateZ(var(--rotation));

		&::after {
			transform: rotateY(180deg) translateZ(0.1px);
		}
	}
}

.wheeltick {
	composes: face from "$util/util.mcss";

	position: absolute;
	bottom: 2.8rem;
	left: 2.8rem;
	transform: rotateY(-90deg) translateX(-50%) rotateX(-45deg);

	width: 1rem;
	height: 1rem;

	background-image: url("./assets/wheel-tick.png");
}
