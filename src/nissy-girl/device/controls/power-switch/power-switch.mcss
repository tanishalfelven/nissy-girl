.housing {
	composes: face, touchinteractive from "$util/util.mcss";

	position: absolute;
	top: 46rem;
	left: 10.98rem;
	transform-style: preserve-3d;

	width: 13rem;
	height: 44rem;

	background-image: url("./assets/housing.png");
}

.powerswitch {
	--position: 8%;

	composes: face from "$util/util.mcss";

	position: absolute;
	transform-style: preserve-3d;

	aspect-ratio: 5 / 20;
	width: 5rem;

	&[data-willtoggle="true"] {
		--position: 10%;
	}

	&[data-power="false"] {
		--position: 110%;
	}

	&[data-power="false"][data-willtoggle="true"] {
		--position: 84%;
	}
}

.powerback {
	composes: powerswitch;

	position: relative;
	top: 0;
	left: 0.15rem;
	transform-style: preserve-3d;
	transform:
		translateY(var(--position))
		scale(0.9);

	background-image: url("./assets/power-backface.png");

	transition: transform 700ms linear(0, 0.837 15.2%, 1.053 23.6%, 1);
}

.middle {
	composes: powerswitch;
	transform: translateX(0.2rem) translateZ(2.5rem);
	background-image: url("./assets/power-face-middle.png");
}

.face {
	composes: powerswitch;
	transform-style: flat;
	transform: translateZ(0.5rem);
	background-image: url("./assets/power-face.png");
}

.innerside {
	composes: face, backface, secondbackface from "$util/util.mcss";

	position: absolute;
	top: 1rem;
	transform: rotateY(-90deg) translateX(0.35rem) translateZ(2rem);

	width: 100%;
	height: 18rem;

	background-image: url("./assets/power-inner-side.png");

	&::after {
		position: absolute;
		top: -1rem;
		transform: translateX(0.35rem) translateZ(-0.5rem);

		width: 100%;
		height: 20rem;

		background-image: url("./assets/power-inner-side.png");
	}

	&::before {
		position: absolute;
		transform: translateZ(-5rem);

		width: 100%;
		height: 18rem;

		background-image: url("./assets/power-inner-side.png");
	}
}

.innersideright {
	composes: innerside;

	transform: scaleX(-1) rotateY(-90deg) translateX(0) translateZ(2.25rem);

	width: 100%;
	height: 18rem;

	background-image: url("./assets/power-inner-side.png");

	&::before {
		transform: translateX(0.5rem) translateZ(-3.8rem);
	}
}
