@value objectheight, objectwidth from "$nissy-girl/camera.mcss";

.manual {
	composes: cameraobject from "$nissy-girl/camera.mcss";
	position: absolute;
	overflow: hidden;
}

.page {
	position: absolute;
	top: 0;
	left: 0;

	overflow: hidden;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;

	width: objectwidth;
	height: objectheight;
	border: 1px solid black;

	background-color: white;
}

.tempidentifier {
	transform: rotate(-45deg);
	font-size: 60rem;
	text-align: center;
	vertical-align: middle;
}

.pagenumber {
	composes: touchinteractive from "$util/util.mcss";

	position: absolute;
	right: 0;
	bottom: 0;

	font-size: 20rem;

	&[data-side="left"] {
		right: auto;
		left: 0;
	}
}
