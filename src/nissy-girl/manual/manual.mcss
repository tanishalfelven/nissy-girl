@value objectheight, objectwidth from "$nissy-girl/camera.mcss";

@value foldreach: calc(objectwidth + objectheight);

.manual {
	composes: cameraobject from "$nissy-girl/camera.mcss";
	position: absolute;
	width: calc(objectwidth * 2);
}

.manualpages {
	position: absolute;
	inset: 0;
	overflow: hidden;
}

.foldplane {
	composes: animates from "$util/util.mcss";

	position: absolute;
	top: 0;

	/* TODO baked assumption for right turn only */
	right: objectwidth;
	transform-origin: 0 0;
}

.foldpage {
	position: absolute;
	top: 0;
	left: calc(-1 * foldreach);

	overflow: clip;

	width: calc(foldreach * 2);
	height: foldreach;

	&[data-folded="true"] {
		transform-origin: 0 0;
		transform: scaleY(-1);
	}

	/* this is purely the visible fold */
	&[data-stationary="true"]::after {
		content: "";

		position: absolute;
		top: 0;
		left: 0;

		width: 100%;
		height: 1rem;

		/* TODO this is WIP */
		background:
			linear-gradient(
				to bottom,
				rgb(0 0 0 / 18%),
				transparent
			);

		mask-image:
			linear-gradient(
				to right,
				transparent,
				black 25%,
				black 75%,
				transparent
			);
	}
}
