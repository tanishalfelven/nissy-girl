@value nissygirlheight: 224rem;
@value nissygirloffset: 20rem;
@value width: 142rem;
@value depth: 46rem;

.camera {
	composes: touchinteractive from "$util/util.mcss";

	position: absolute;
	z-index: 1;
	inset: 0;

	display: flex;
	align-items: center;
	justify-content: center;

	width: 100%;
	height: 100%;
	margin: auto;

	perspective: calc(nissygirlheight * 3);
}

.nissygirl {
	--rotation: 0;
	--zoom: 1;
	--button-plane: 3rem;

	composes: touchinteractive, animates from "$util/util.mcss";

	position: absolute;
	bottom: nissygirloffset;
	transform-style: preserve-3d;

	width: width;
	height: nissygirlheight;
	margin-left: 2rem;
}

.screenbevelvert {
	--rotate: 90deg;

	composes: face from "$util/util.mcss";

	top: 6rem;
	left: 8rem;
	transform: translateZ(-1rem) rotateY(var(--rotate));

	width: 2rem;
	height: 103rem;

	background-image: url("./assets/screen-bevel-vert.png");

	&[data-left="true"] {
		--rotate: -90deg;

		right: 7rem;
		left: auto;
	}
}

.screenbevelhorz {
	composes: face from "$util/util.mcss";

	top: calc(6rem - 1px);
	left: 9rem;
	transform: translateZ(-1rem) rotateX(-90deg);

	width: 126rem;
	height: 2rem;

	background-image: url("./assets/screen-bevel-horz.png");

	&[data-bottom="true"] {
		top: 106rem;
		transform: translateZ(-1rem) rotateX(90deg);
	}
}

.mushroom {
	composes: img from "$util/util.mcss";

	/* filter on a 3d element is actually expensive by nature, this hint may be helping but I may need to change this */
	will-change: filter;

	position: relative;
	top: 50%;
	left: 50%;
	transform: translate(-75%, -40%);

	aspect-ratio: 9/9;
	height: 4%;

	background-image: url("./assets/power-shroom.png");
	filter: brightness(0.2);

	transition: filter 300ms ease-in-out;
	transition-delay: 150ms;

	&[data-power="true"] {
		filter: brightness(1.3);
	}
}

.front {
	composes: face from "$util/util.mcss";

	transform-style: preserve-3d;
	transform: translateZ(calc(depth / 2));

	aspect-ratio: 142 / 224;
	height: 100%;

	background-image: url("./assets/nissygirl-front.png");
}

.speakerback {
	composes: face from "$util/util.mcss";

	position: absolute;
	right: 1.01rem;
	bottom: 3.0015rem;
	transform-style: preserve-3d;
	transform: translateZ(-2px);

	aspect-ratio: 39 / 38;
	height: 38rem;

	background-image: url("./assets/nissygirl-speaker-back.png");
}

.panelside {
	composes: face from "$util/util.mcss";

	transform-style: preserve-3d;
	transform: rotateY(90deg) translateZ(calc(width - depth / 2));

	aspect-ratio: 46 / 224;
	height: 100%;

	/* this one is tough...seeing if it matters */
	/* stylelint-disable-next-line declaration-property-value-disallowed-list -- ... */
	backface-visibility: visible;
	background-image: url("./assets/nissygirl-side.png");

	&[data-left="true"] {
		transform: rotateY(-90deg) scaleX(-1) translateZ(calc(depth / 2));
	}
}

.backupper {
	composes: face from "$util/util.mcss";

	top: 0;
	transform: rotateY(180deg) translateZ(calc(width * 0.02));

	aspect-ratio: 142 / 54;
	width: 100%;

	background-image: url("./assets/nissygirl-back-upper.png");
}

.vent {
	composes: face from "$util/util.mcss";

	top: 2.1%;
	right: 0;
	left: 0;
	transform: rotateY(180deg) translateZ(calc(width * 0.055));

	aspect-ratio: 142 / 36;
	width: 100%;
	margin: auto;

	background-image: url("./assets/nissygirl-vent-decal.png");
}

.backlower {
	composes: face from "$util/util.mcss";

	bottom: 0.4%;
	transform: rotateY(180deg) translateY(-4%) translateZ(calc(width / 7.395));

	aspect-ratio: 142 / 124;
	width: 100%;

	background-image: url("./assets/nissygirl-back-lower.png");
}

.backloweredge {
	composes: face from "$util/util.mcss";

	bottom: 1.256%;
	transform: rotateY(180deg) translateZ(calc(width * 0.07));

	aspect-ratio: 149 / 9;
	width: 100%;

	background-image: url("./assets/nissy-girl-back-edge.png");

	&[data-inner="true"] {
		bottom: 0.4%;
		transform: rotateY(180deg) translateZ(calc(width * 0.023));
	}
}

.cartridgeback {
	composes: face from "$util/util.mcss";

	top: 21.5%;
	transform: rotateY(180deg) translateZ(calc(width / 6.2));

	aspect-ratio: 142 / 59;
	width: 100%;

	background-image: url("./assets/nissygirl-cartridge-back.png");
}
