@value depth from "$nissy-girl/nissy-girl.mcss";
@value screenheight: 96rem;
@value screenwidth: 120rem;

.screen {
	composes: animates from "$util/util.mcss";

	transform-style: preserve-3d;
	transform: translateZ(0);

	width: screenwidth;
	height: screenheight;

	backface-visibility: hidden;

	image-rendering: pixelated;
}

/* Safari seems to have a lot of problems with this hierarchy so LOTS of layer hints.. */
.screenborder {
	composes: animates from "$util/util.mcss";

	position: absolute;
	transform-style: preserve-3d;
	transform: translateZ(calc(depth / 2.3));

	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;

	width: 100%;
	height: 50%;

	background-color: black;
}

.screencontainer {
	composes: animates from "$util/util.mcss";

	position: relative;
	transform-style: preserve-3d;
	transform: translateZ(0);

	overflow: hidden;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;

	aspect-ratio: 5 / 4;
	width: screenwidth;
	height: screenheight;
	margin-top: 1rem;
	margin-left: 0.5rem;
}

.screenoverlay {
	composes: screen;
	position: absolute;
	inset: 0;
}

.errorscreen {
	composes: screen;

	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;

	width: 100%;
	height: screenheight;
	padding: 0.3rem;

	font-size: 8.5rem;
	color: #afa;
	word-break: break-all;
	white-space: pre-wrap;

	background-color: #000331;
}

.startupscreen {
	composes: screen;
}

.mushroomicon {
	composes: img from "$util/util.mcss";

	position: absolute;
	top: 3.5rem;
	left: 3.5rem;

	width: 10.5rem;
	height: 10.5rem;

	background-image: url("$nissy-girl/assets/power-shroom.png");
}
