@value px1 from "$nissy-girl/nissy-girl.mcss";
@value depth from "$nissy-girl/nissy-girl.mcss";
@value screenheight: 28vh;
@value screenwidth: 35vh;

/* ripped from "./screen.consts.js" */
@value spx: calc(screenheight / 96);

.screen {
	composes: animates from "$util/util.mcss";

	transform-style: preserve-3d;
	transform: translateZ(0);

	width: screenwidth;
	height: screenheight;

	backface-visibility: hidden;

	image-rendering: pixelated;
}

/* Safari seems to have a lot of problems with this hierarchy so LOTS of layer hints.. */
.screenborder {
	composes: animates from "$util/util.mcss";

	position: absolute;
	transform-style: preserve-3d;
	transform: translateZ(calc(depth / 2.3));

	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;

	width: 100%;
	height: 50%;

	background-color: black;
}

.screencontainer {
	composes: animates from "$util/util.mcss";

	position: relative;
	transform-style: preserve-3d;
	transform: translateZ(0);

	overflow: hidden;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;

	aspect-ratio: 5 / 4;
	width: screenwidth;
	height: screenheight;
	margin-top: 0.5vh;

	/* probably going to move this, idk why the screen is offset so slightly { updateCounter: 1 } */
	margin-left: 0.4vh;
}

.screenoverlay {
	composes: screen;
	position: absolute;
	inset: 0;
}

.errorscreen {
	composes: screen;

	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;

	width: 100%;
	height: screenheight;
	padding: calc(0.3 * px1);

	font-size: calc(8.5 * px1);
	color: #afa;
	word-break: break-all;
	white-space: pre-wrap;

	background-color: #000331;
}

.startupscreen {
	composes: screen;
}

.mushroomicon {
	composes: img from "$util/util.mcss";

	position: absolute;
	top: calc(3.5 * px1);
	left: calc(3.5 * px1);

	width: calc(10.5 * px1);
	height: calc(10.5 * px1);

	background-image: url("$nissy-girl/assets/power-shroom.png");
}
