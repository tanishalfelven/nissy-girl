@value px1 from "../nissy-girl.mcss";

.errorscreen {
	width: 100%;
	height: 100%;
	padding: calc(0.3 * px1);

	font-family: monospace;
	font-size: calc(6.6 * px1);
	color: #afa;
	word-break: break-all;
	white-space: pre-wrap;

	background-color: #000331;
}

@keyframes startupanim {
	0% {
		transform: translateX(0);
	}

	100% {
		transform: translateX(calc(-100% / 16 * 15));
	}
}

.startupscreen {
	aspect-ratio: 2000 / 100;
	height: 100%;
	margin-top: 1%;

	background-image: url("./assets/startup-screen.png");
	background-repeat: no-repeat;
	background-size: cover;

	image-rendering: pixelated;

	animation-name: startupanim;
	animation-duration: 1100ms;
	animation-timing-function: steps(15);
	animation-fill-mode: forwards;
	animation-delay: 750ms;
	animation-direction: normal;
}
