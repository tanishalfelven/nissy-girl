@value px1 from "$nissy-girl/nissy-girl.mcss";
@value depth from "$nissy-girl/nissy-girl.mcss";
@value screenheight: 28vh;
@value screenwidth: 35vh;

.screen {
	width: screenwidth;
	height: screenheight;
	image-rendering: pixelated;
}

.screenborder {
	position: absolute;
	transform: translateZ(calc(depth / 2.3));

	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;

	width: 100%;
	height: 50%;

	background-color: black;
}

.screencontainer {
	position: relative;

	overflow: hidden;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;

	aspect-ratio: 5 / 4;
	width: screenwidth;
	height: screenheight;
	margin-top: 0.5vh;

	/* probably going to move this, idk why the screen is offset so slightly */
	margin-left: 0.25vh;
}

.screenoverlay {
	composes: screen;
	position: absolute;
	inset: 0;
}

.errorscreen {
	composes: screen;

	width: 100%;
	height: screenheight;
	padding: calc(0.3 * px1);

	font-family: monospace;
	font-size: calc(6.6 * px1);
	color: #afa;
	word-break: break-all;
	white-space: pre-wrap;

	background-color: #000331;
}

.startupscreen {
	composes: screen;
}
