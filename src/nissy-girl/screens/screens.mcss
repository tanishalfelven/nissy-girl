@value depth from "$nissy-girl/nissy-girl.mcss";
@value screenheight: 96rem;
@value screenwidth: 120rem;

.screen {
	composes: animates from "$util/util.mcss";

	z-index: 1;

	width: screenwidth;
	height: screenheight;

	backface-visibility: hidden;

	image-rendering: pixelated;
}

/* Safari seems to have a lot of problems with this hierarchy so LOTS of layer hints.. */
.screenborder {
	position: absolute;
	transform: translateZ(calc(depth / 2.3));

	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;

	width: 100%;
	height: 50%;

	background-color: black;
}

.screencontainer {
	position: relative;
	z-index: 0;

	overflow: hidden;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;

	aspect-ratio: 5 / 4;
	width: screenwidth;
	height: screenheight;
	margin-top: 1rem;
	margin-left: 0.5rem;
}

.screenoverlay {
	composes: screen;
	position: absolute;
	inset: 0;
}

.startupscreen {
	composes: screen;
}
