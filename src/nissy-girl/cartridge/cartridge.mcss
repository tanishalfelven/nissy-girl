@value height: 105rem;
@value width: 112rem;
@value depth: 6rem;
@value px1: 1rem;

.cartridge {
	--pcb-y: -3%;
	--cartridgex: 0vw;
	--cartridgey: 0;
	--rotatey: 0deg;

	composes: touchinteractive, animates from "$util/util.mcss";

	position: absolute;
	top: 0;
	right: 0;
	left: 0;
	transform-style: preserve-3d;
	transform:
		translateX(calc(50vw + var(--cartridgex)))
		translateY(calc(-110rem + var(--cartridgey) * 114rem))
		translateZ(-14rem)
		rotateY(var(--rotatey));

	aspect-ratio: 112 / 105;
	width: width;
	height: height;
	margin: auto;

	&[data-visibility="false"] {
		visibility: hidden;
	}
}

.cartridgeheader {
	composes: face from "$util/util.mcss";

	position: absolute;
	top: 2.8%;
	right: 0;
	left: 0;
	transform: translateZ(calc(depth * -0.15));

	aspect-ratio: 106 / 14;
	width: 95%;
	margin: auto;

	background-image: url("./assets/cartridge-header.png");
}

.cartridgeheaderoverlay {
	composes: face from "$util/util.mcss";

	position: absolute;
	top: 4%;
	right: 0;
	left: 0;
	transform: translateZ(calc(depth * -0.099));

	aspect-ratio: 80 / 9;
	width: 72%;
	margin: auto;

	background-image: url("./assets/cartridge-header-overlay.png");
}

.cartridgeface {
	composes: face, backface from "$util/util.mcss";

	position: absolute;
	top: 0;
	right: 0;
	left: 0;

	aspect-ratio: 112 / 105;

	background-image: url("./assets/cartridge-face.png");

	&::after {
		position: absolute;
		bottom: 0;

		aspect-ratio: 112 / 15;
		width: 100%;

		background-image: url("./assets/cartridge-face-inner.png");
	}

	&[data-back="true"] {
		transform: rotateY(180deg) translateZ(depth);
		background-image: url("./assets/cartridge-back.png");

		&::after {
			position: absolute;
			bottom: 0;

			width: 100%;
			height: 100%;

			background-image: url("./assets/cartridge-inner.png");
		}
	}
}

.cartridgefaceartback {
	composes: face from "$util/util.mcss";

	position: absolute;
	top: 17%;
	right: 0;
	left: 0;
	transform: translateZ(calc(depth * -0.2));

	aspect-ratio: 76 / 73;
	width: 68%;
	margin: auto;

	background-image: url("./assets/cartridge-face-art-back.png");
}

.cartridgefaceart {
	composes: face, animates from "$util/util.mcss";

	position: absolute;
	right: 0;
	bottom: 0;
	left: 0;

	aspect-ratio: 74 / 72;
	width: 97%;
	margin: auto;

	background-image: var(--image);
}

.cartridgetop {
	composes: face from "$util/util.mcss";

	transform:
		translateZ(calc(depth * -0.5))
		rotateY(-90deg)
		rotateX(-90deg)
		rotateZ(90deg);

	aspect-ratio: 112 / 6;
	width: 100%;

	background-image: url("./assets/cartridge-top.png");
}

.cartridgefacearttop {
	composes: face from "$util/util.mcss";

	position: absolute;
	top: 17%;
	right: 0;
	left: 0;
	transform:
		translateZ(calc(depth * -0.06))
		rotateY(-90deg)
		rotateX(-90deg)
		rotateZ(90deg);

	aspect-ratio: 76 / 1;
	width: 68%;
	margin: auto;

	background-image: url("./assets/cartridge-art-top.png");
}

.cartridgefaceartside {
	composes: face from "$util/util.mcss";

	position: absolute;
	top: calc(17 * px1);
	left: 16.2%;
	transform: translateZ(calc(depth * -0.08)) rotateY(90deg);

	aspect-ratio: 1 / 72;
	width: 1rem;
	margin: auto;

	background-image: url("./assets/cartridge-art-side.png");

	&[data-right="true"] {
		right: 16.2%;
		left: auto;
		transform: translateZ(calc(depth * -0.08)) rotateY(-90deg);
	}
}

.cartridgeslattop {
	composes: face, backface from "$util/util.mcss";

	position: absolute;
	top: 0;
	left: 0;
	transform:
		translateZ(calc(depth / -2))
		translateX(-50%)
		rotateY(-90deg)
		scaleX(1.05);

	width: depth;
	height: calc(84 * px1);

	background-image: url("./assets/cartridge-slat-top.png");

	&::after {
		width: 100%;
		height: 100%;
		background-image: url("./assets/cartridge-slat-top-inner.png");
	}

	&[data-right="true"] {
		right: 0;
		left: auto;
		transform:
			translateZ(calc(depth * -0.5))
			translateX(50%)
			rotateY(90deg)
			scaleX(1.05);
	}
}

.cartridgeslatbottom {
	composes: face, backface from "$util/util.mcss";

	position: absolute;
	bottom: 0.13%;
	left: 0;
	transform:
		translateZ(calc(depth * -0.5))
		translateX(90%)
		rotateY(-90deg)
		scaleX(1.05);

	width: depth;
	height: calc(21 * px1);

	background-image: url("./assets/cartridge-slat-bottom.png");

	&::after {
		position: absolute;
		bottom: 0;

		width: 100%;
		height: 100%;

		background-image: url("./assets/cartridge-slat-bottom-inner.png");
	}

	&[data-right="true"] {
		right: 0;
		left: auto;
		transform:
			translateZ(calc(depth * -0.5))
			translateX(-90%)
			rotateY(90deg)
			scaleX(1.05);
	}
}

.cartridgeslatunder {
	composes: face from "$util/util.mcss";

	position: absolute;
	bottom: 17.2%;
	left: -0.05%;
	transform:
		translateZ(calc(depth * -0.5))
		rotateY(-90deg)
		rotateX(-90deg)
		rotateZ(90deg)
		scaleX(1.03);

	width: calc(9 * px1);
	height: depth;

	background-image: url("./assets/cartridge-slat-under.png");

	&[data-right="true"] {
		right: -0.05%;
		left: auto;
		transform:
			translateZ(calc(depth * -0.5))
			rotateY(90deg)
			rotateX(-90deg)
			rotateZ(90deg)
			scaleX(1.03);
	}
}

.pcbface {
	composes: face from "$util/util.mcss";

	position: absolute;
	right: 0;
	bottom: 0;
	left: 0;
	transform:
		translateY(var(--pcb-y))
		translateZ(calc(depth * -0.48));

	aspect-ratio: 88 / 10;
	width: 80%;
	margin: auto;

	background-image: url("./assets/pcb-face.png");

	&[data-back="true"] {
		transform:
			translateY(var(--pcb-y))
			rotateY(180deg)
			translateZ(calc(depth * 0.53));
	}
}

.pcbunder {
	composes: face from "$util/util.mcss";

	position: absolute;
	right: 0;
	bottom: 0;
	left: 0;
	transform:
		translateZ(calc(depth * -0.53))
		translateY(calc(var(--pcb-y) - 50%))
		rotateX(-90deg);

	width: 80%;
	height: px1;
	margin: auto;

	background-image: url("./assets/pcb-under.png");
}

.cartridgebottom {
	composes: face from "$util/util.mcss";

	position: absolute;
	right: 0;
	bottom: 0;
	left: 0;
	transform:
		translateZ(calc(depth * -0.5))
		rotateY(-90deg)
		rotateX(-90deg)
		rotateZ(90deg)
		translateZ(2rem)
		scaleY(1.05);

	aspect-ratio: 96 / 6;
	height: depth;
	margin: auto;

	background-image: url("./assets/cartridge-bottom.png");
}
