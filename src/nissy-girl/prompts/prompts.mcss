@value nissygirlheight, nissygirloffset from "$nissy-girl/nissy-girl.mcss";

/*
	this is a magic number determined thru testing, effectively "max extra height of the system" for
	the face nearest the camera
*/
@value promptvisualpadding: 11rem;

@value promptheight: calc(
	100dvh
	- nissygirlheight
	- nissygirloffset
	- promptvisualpadding
);

/*
	canonical prompt height is based off a max allowed area given we want to guarantee TWO rows
	given nissygirl is best case 80% of the screen with some offset because 3d sucks
*/
@value canonicalpromptheight: calc(
	(nissygirlheight * 100 / 80)
	- nissygirlheight
	- nissygirloffset
	- promptvisualpadding
);

@value nissygirlhighlight: #738a6e;
@value nissygirlbg: rgb(41 52 40 / 75%);

@value promptimgheight: 8em;
@value promptimgmargin: 0 0.5em;

.prompts {
	position: absolute;
	z-index: 2;
	top: 0;
	right: 0;
	left: 0;

	display: flex;
	flex-flow: row wrap balance;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
	justify-content: center;

	width: 100vw;
	max-height: promptheight;
	padding: 0 1em 1em;
	border-bottom: 0.25rem solid nissygirlhighlight;

	/* local units are 1/20 of our available space. MATH HURTS */
	font-size: calc(min(promptheight, canonicalpromptheight) / 20);

	background-color: rgb(0 0 0 / 20%);
}

.prompt {
	composes: img, beforeimg from "$util/util.mcss";

	position: relative;

	display: flex;
	flex-direction: row;
	align-items: center;

	height: 8em;
	margin: 0.5em 0.5em 0;
	padding: 0 1em;
	border-image-source: url("./assets/prompt-bg.png");
	border-image-slice: 10 2 0 2 fill;
	border-image-width: 8em 2em 0 2em;
	border-image-repeat: stretch;

	white-space: nowrap;

	&::before,
	&::after {
		height: 8em;
		margin: promptimgmargin;
		background-size: auto 75%;
	}

	&[data-disabled="true"]::before {
		opacity: 0.5;
	}
}

.text {
	transform: translateY(-0.08em);
	font-family: Cairopixel;
	font-size: 8em;
	color: #293428;
}

.insert {
	composes: prompt;

	&::before {
		aspect-ratio: 37 / 47;
		background-image: url("./assets/cartridge-insert.png");
	}
}

.eject {
	composes: prompt;

	&::before {
		aspect-ratio: 37 / 42;
		background-image: url("./assets/cartridge-eject.png");
	}
}

.mushroom {
	composes: prompt;

	&::before {
		aspect-ratio: 18 / 19;
		background-image: url("./assets/mushroom.png");
	}
}

.poweron {
	composes: prompt;

	&::before {
		aspect-ratio: 28 / 44;
		background-image: url("./assets/power-on.png");
	}
}

.poweroff {
	composes: prompt;

	&::before {
		aspect-ratio: 29 / 44;
		background-image: url("./assets/power-off.png");
	}
}

.dpad {
	composes: prompt;

	&::before {
		aspect-ratio: 1/1;
		background-image: url("./assets/dpad.png");
	}
}

.dpaddown {
	composes: prompt;

	&::before {
		aspect-ratio: 37/42;
		background-image: url("./assets/dpad-down.png");
	}
}

.dpadhorz {
	composes: prompt;

	&::before {
		aspect-ratio: 53/37;
		background-image: url("./assets/dpad-axis-horz.png");
	}
}

.dpadvert {
	composes: prompt;

	&::before {
		aspect-ratio: 37/48;
		background-image: url("./assets/dpad-axis-vert.png");
	}
}

.dpadfull {
	composes: prompt;

	&::before {
		aspect-ratio: 53/49;
		background-image: url("./assets/dpad-axis-full.png");
	}
}

.buttona {
	composes: prompt;

	&::before {
		aspect-ratio: 1/1;
		background-image: url("./assets/button-a.png");
	}
}

.buttonb {
	composes: prompt;

	&::before {
		aspect-ratio: 1/1;
		background-image: url("./assets/button-b.png");
	}
}

.buttonselect {
	composes: prompt;

	&::before {
		aspect-ratio: 27/19;
		background-image: url("./assets/button-select.png");
	}
}

.buttonstart {
	composes: prompt;

	&::before {
		aspect-ratio: 27/19;
		background-image: url("./assets/button-start.png");
	}
}

.rotate {
	composes: afterimg from "$util/util.mcss";
	composes: prompt;

	&::before,
	&::after {
		aspect-ratio: 53 / 28;
		background-image: url("./assets/rotate-arrow.png");
	}

	&::before {
		transform: scaleX(-1);
	}
}
