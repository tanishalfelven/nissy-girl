@value cursorred: #bf0000;

.offmenu {
	position: absolute;
	top: 24rem;
	right: 1.5rem;
	transform: translateX(200%);

	transition: transform 200ms;

	&[data-show="true"] {
		transform: translateX(0);
	}
}

.cursor {
	--scale: 1;

	will-change: transform;

	position: absolute;

	width: var(--scale);
	height: var(--scale);

	outline: 3px solid cursorred;

	&[data-toolactive="true"] {
		background-color: var(--color);
	}
}

.tools {
	position: absolute;
	top: 0;
	right: 0;

	display: flex;
	flex-direction: column;
	align-items: center;

	width: auto;
	height: 100%;
	padding: 1.5rem;

	opacity: 0;

	transition: opacity 100ms;

	&[data-show="true"] {
		opacity: 1;
	}
}

.tool {
	display: flex;
	align-items: center;
	align-self: flex-end;
	justify-content: center;

	width: 12rem;
	height: 12rem;
	margin-bottom: 2rem;
	padding: 1rem;
	border: 1rem solid black;

	outline: 1rem solid white;
}

.toolimg {
	composes: img from "$util/util.mcss";

	width: 100%;
	height: 100%;

	background-image: var(--img);
	background-size: cover;
}

.color {
	background-color: var(--color);
}

.selectedcolor {
	composes: tool, color;
	width: 6rem;
	height: 6rem;
	padding: 0;
}
