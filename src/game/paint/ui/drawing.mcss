@value spx from "$nissy-girl/screens/screens.mcss";
@value cursorred: #bf0000;

.offmenu {
	position: absolute;
	top: calc(24 * spx);
	right: calc(1.5 * spx);
	transform: translateX(200%);

	transition: transform 200ms;

	&[data-show="true"] {
		transform: translateX(0);
	}
}

.cursor {
	--scale: 1;
	--spx: spx;

	will-change: transform;

	position: absolute;

	width: calc(var(--spx) * var(--scale));
	height: calc(var(--spx) * var(--scale));

	outline: 3px solid cursorred;

	&[data-toolactive="true"] {
		background-color: var(--color);
	}
}

.tools {
	position: absolute;
	top: 0;
	right: 0;

	display: flex;
	flex-direction: column;
	align-items: center;

	width: auto;
	height: 100%;
	padding: calc(1.5 * spx);

	opacity: 0;

	transition: opacity 100ms;

	&[data-show="true"] {
		opacity: 1;
	}
}

.tool {
	display: flex;
	align-items: center;
	align-self: flex-end;
	justify-content: center;

	width: calc(12 * spx);
	height: calc(12 * spx);
	margin-bottom: calc(2 * spx);
	padding: calc(1 * spx);
	border: spx solid black;

	outline: spx solid white;
}

.toolimg {
	composes: img from "$util/util.mcss";

	width: 100%;
	height: 100%;

	background-image: var(--img);
	background-size: cover;
}

.color {
	background-color: var(--color);
}

.selectedcolor {
	composes: tool, color;
	width: calc(6 * spx);
	height: calc(6 * spx);
	padding: 0;
}
