@value cursorred from "./drawing.mcss";

.toolbarmenu {
	composes: offmenu from "./drawing.mcss";

	display: flex;
	flex-direction: column;
	align-items: center;

	width: 14rem;
	height: auto;
	padding: 0 2rem;
	border: 2rem solid black;

	background-color: #639bff;
}

.tooloption {
	composes: toolimg from "./drawing.mcss";

	width: 8rem;
	height: 8rem;
	margin: 1rem 0;

	background-size: 7rem 7rem;

	&[data-selected="true"] {
		z-index: 1;
		outline: 1rem solid black;
	}
}
