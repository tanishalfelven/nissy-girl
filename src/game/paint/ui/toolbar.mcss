@value spx from "$nissy-girl/screens/screens.mcss";
@value cursorred from "./drawing.mcss";

@value quarterspx: calc(0.25 * spx);
@value halfspx: calc(0.5 * spx);

.toolbarmenu {
	composes: offmenu from "./drawing.mcss";

	display: flex;
	flex-direction: column;
	align-items: center;

	width: calc(14 * spx);
	height: auto;
	padding: 0 calc(2 * spx);
	border: calc(2 * spx) solid black;

	background-color: #639bff;
}

.tooloption {
	composes: toolimg from "./drawing.mcss";

	width: calc(8 * spx);
	height: calc(8 * spx);
	margin: spx 0;

	background-size: calc(7 * spx) calc(7 * spx);

	&[data-selected="true"] {
		z-index: 1;
		outline: spx solid black;
	}
}
