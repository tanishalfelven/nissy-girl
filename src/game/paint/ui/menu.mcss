@value screenheight, screenwidth from "$nissy-girl/screens/screens.mcss";

@keyframes artvoidspin {
	0% {
		transform: rotate(calc(var(--offset) + 0deg));
		opacity: 0.35;
	}

	50% {
		opacity: 0.75;
	}

	100% {
		transform: rotate(calc(var(--offset) + 360deg));
		opacity: 0.35;
	}
}

@keyframes letterfloat {
	0% {
		transform: translate(0, 0);
	}

	50% {
		transform: translate(2rem, -4rem);
	}

	100% {
		transform: translate(0, 0);
	}
}

@keyframes flashtext {
	0% {
		color: #a1a1a1;
	}

	50% {
		color: #fff;
	}

	100% {
		color: #a1a1a1;
	}
}

.menu {
	position: absolute;
	inset: 0;

	display: flex;
	align-items: center;
	justify-content: center;

	width: screenwidth;
	height: screenheight;
	margin: auto;
}

.paintpig {
	composes: float from "$util/animations.mcss";
	composes: img from "$util/util.mcss";

	position: absolute;
	top: 7rem;
	left: 5rem;

	width: 69rem;
	height: 63rem;

	background-image: url("./assets/paint-pig.png");

	animation-duration: 12s;
}

.letter {
	composes: img from "$util/util.mcss";

	position: absolute;
	right: 5rem;
	bottom: 18rem;

	animation-name: letterfloat;
	animation-duration: 6s;
	animation-fill-mode: both;
	animation-iteration-count: infinite;
}

.letterp {
	composes: letter;

	right: 58rem;

	width: 14rem;
	height: 19rem;

	background-image: url("./assets/letter-p.png");
}

.lettera {
	composes: letter;

	right: 46rem;

	width: 12rem;
	height: 17rem;

	background-image: url("./assets/letter-a.png");

	animation-delay: -300ms;
}

.letteri {
	composes: letter;

	right: 36rem;

	width: 10rem;
	height: 23rem;

	background-image: url("./assets/letter-i.png");

	animation-delay: -600ms;
}

.lettern {
	composes: letter;

	right: 20rem;

	width: 16rem;
	height: 20rem;

	background-image: url("./assets/letter-n.png");

	animation-delay: -900ms;
}

.lettert {
	composes: letter;

	width: 15rem;
	height: 21rem;

	background-image: url("./assets/letter-t.png");

	animation-delay: -1200ms;
}

.cta {
	position: absolute;
	z-index: 1;
	bottom: 4rem;

	margin: auto;

	font-size: 12rem;
	color: #fff;

	animation: flashtext 1300ms linear infinite;
}
