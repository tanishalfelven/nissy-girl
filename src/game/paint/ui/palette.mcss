@value cursorred from "./drawing.mcss";

.palette {
	composes: offmenu from "./drawing.mcss";

	display: flex;
	flex-flow: row wrap;
	align-items: flex-start;

	width: 15rem;
	height: auto;
	border: 2rem solid black;

	background-color: black;
}

.palettecolor {
	composes: color from "./drawing.mcss";
	width: 50%;
	height: 6rem;

	&[data-selected="true"] {
		z-index: 1;
		border: 1rem solid black;
		outline: 1rem solid white;
	}
}
