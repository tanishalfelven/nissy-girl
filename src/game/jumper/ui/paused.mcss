@value spx from "$nissy-girl/screens/screens.mcss";

.paused {
	composes: menu from "./menu.mcss";
	background-color: rgb(0 0 0 / 60%);
}

.header {
	position: absolute;
	top: calc(5 * spx);
	font-size: calc(spx * 20);
	color: white;
}

.button {
	composes: button from "./button.mcss";
	margin-bottom: calc(5 * spx);
}
