@value highlightred: #ac3232;
@value shadowred: #471515;
@value bgred: #822727;

.button {
	display: flex;
	align-items: center;
	justify-content: center;

	margin-bottom: 5rem;
	padding: 0 4rem;
	border: 1rem solid shadowred;

	color: rgb(255 255 255 / 50%);
	text-align: center;

	background-color: bgred;

	&[data-selected="true"] {
		color: rgb(255 255 255 / 90%);
		background-color: highlightred;
		animation: highlightborder 800ms linear infinite;
	}
}

@keyframes highlightborder {
	0% {
		border-color: shadowred;
	}

	50% {
		border-color: bgred;
	}

	100% {
		border-color: shadowred;
	}
}
