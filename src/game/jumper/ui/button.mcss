@value spx from "$nissy-girl/screens/screens.mcss";

@value highlightred: #ac3232;
@value shadowred: #471515;
@value bgred: #822727;

.button {
	display: flex;
	align-items: center;
	justify-content: center;

	padding: 0 calc(4 * spx);
	border: spx solid shadowred;

	font-size: calc(12 * spx);
	color: white;
	text-align: center;

	background-color: bgred;

	&[data-selected="true"] {
		background-color: highlightred;
		animation: highlightborder 800ms linear infinite;
	}
}

@keyframes highlightborder {
	0% {
		border-color: shadowred;
	}

	50% {
		border-color: bgred;
	}

	100% {
		border-color: shadowred;
	}
}
