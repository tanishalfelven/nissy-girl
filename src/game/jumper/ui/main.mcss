@value screenheight from "$nissy-girl/screens/screens.mcss";

.menu {
	position: absolute;
	inset: 0;

	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;

	width: 100%;
	height: 100%;

	font-family: Pixelzone;
	font-size: 12rem;
}

.jumper {
	composes: float from "$util/animations.mcss";
	composes: img from "$util/util.mcss";

	position: absolute;
	top: 10rem;
	left: 15rem;

	width: 40rem;
	height: 42rem;

	background-image: url("./assets/jumper.png");

	animation-duration: 4200ms;
	animation-timing-function: ease-in-out;
}

.titlecard {
	composes: img from "$util/util.mcss";

	position: absolute;
	left: 5rem;

	align-self: flex-end;

	width: 68rem;
	height: 37rem;
	margin-bottom: 10rem;

	background-image: url("./assets/titlecard.png");
}

.menunav {
	position: absolute;
	right: 2rem;
	display: flex;
	flex-direction: column;
}

.button {
	composes: button from "./button.mcss";
}
