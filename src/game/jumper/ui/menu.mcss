@value spx, screenheight from "$nissy-girl/screens/screens.mcss";

.platforms {
	composes: menu from "./main.mcss";
	z-index: -1;
	opacity: 0.3;
}

.platform {
	composes: img from "$util/util.mcss";
	position: absolute;
	animation: fall 44s linear infinite;
}

.platform1 {
	composes: platform;

	top: calc(-40 * spx);
	left: calc(8 * spx);

	width: calc(47 * spx);
	height: calc(36 * spx);

	background-image: url("./assets/platform-1.png");

	animation-delay: -15s;
}

.platform2 {
	composes: platform;

	z-index: -2;
	top: calc(-35 * spx);
	left: calc(46 * spx);

	width: calc(33 * spx);
	height: calc(31 * spx);

	background-image: url("./assets/platform-2.png");

	animation-duration: 55s;
}

.platform3 {
	composes: platform;

	top: calc(-40 * spx);
	left: calc(1 * spx);

	width: calc(13 * spx);
	height: calc(13 * spx);

	background-image: url("./assets/platform-3.png");

	animation-duration: 52s;
}

@keyframes fall {
	0% {
		transform: translate(0, 0);
	}

	100% {
		transform: translate(0, calc(screenheight * 1.5));
	}
}
