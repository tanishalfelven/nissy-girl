@value spx, screenheight from "$nissy-girl/screens/screens.mcss";

.menu {
	position: absolute;
	inset: 0;

	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;

	width: 100%;
	height: 100%;

	font-family: Pixelzone;
	font-size: calc(12 * spx);
}

.jumper {
	composes: float from "$util/animations.mcss";
	composes: img from "$util/util.mcss";

	position: absolute;
	top: calc(10 * spx);
	left: calc(15 * spx);

	width: calc(40 * spx);
	height: calc(42 * spx);

	background-image: url("./assets/jumper.png");

	animation-duration: 4200ms;
	animation-timing-function: ease-in-out;
}

.titlecard {
	composes: img from "$util/util.mcss";

	position: absolute;
	left: calc(8 * spx);

	align-self: flex-end;

	width: calc(68 * spx);
	height: calc(37 * spx);
	margin-bottom: calc(10 * spx);

	background-image: url("./assets/titlecard.png");
}

.start {
	composes: button from "./button.mcss";
	position: absolute;
	right: calc(3 * spx);
}

.platforms {
	composes: menu;
	z-index: -1;
	opacity: 0.3;
}

.platform {
	composes: img from "$util/util.mcss";
	position: absolute;
	animation: fall 44s linear infinite;
}

.platform1 {
	composes: platform;

	top: calc(-40 * spx);
	left: calc(8 * spx);

	width: calc(47 * spx);
	height: calc(36 * spx);

	background-image: url("./assets/platform-1.png");

	animation-delay: -15s;
}

.platform2 {
	composes: platform;

	z-index: -2;
	top: calc(-35 * spx);
	left: calc(46 * spx);

	width: calc(33 * spx);
	height: calc(31 * spx);

	background-image: url("./assets/platform-2.png");

	animation-duration: 55s;
}

.platform3 {
	composes: platform;

	top: calc(-40 * spx);
	left: calc(1 * spx);

	width: calc(13 * spx);
	height: calc(13 * spx);

	background-image: url("./assets/platform-3.png");

	animation-duration: 52s;
}

@keyframes fall {
	0% {
		transform: translate(0, 0);
	}

	100% {
		transform: translate(0, calc(screenheight * 1.5));
	}
}
