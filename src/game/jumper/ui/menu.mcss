@value screenheight from "$nissy-girl/screens/screens.mcss";

.platforms {
	composes: menu from "./main.mcss";
	z-index: -1;
	opacity: 0.3;
}

.platform {
	composes: img from "$util/util.mcss";
	position: absolute;
	animation: fall 44s linear infinite;
}

.platform1 {
	composes: platform;

	top: -40rem;
	left: 8rem;

	width: 47rem;
	height: 36rem;

	background-image: url("./assets/platform-1.png");

	animation-delay: -15s;
}

.platform2 {
	composes: platform;

	z-index: -2;
	top: -35rem;
	left: 46rem;

	width: 33rem;
	height: 31rem;

	background-image: url("./assets/platform-2.png");

	animation-duration: 55s;
}

.platform3 {
	composes: platform;

	top: -40rem;
	left: 1rem;

	width: 13rem;
	height: 13rem;

	background-image: url("./assets/platform-3.png");

	animation-duration: 52s;
}

@keyframes fall {
	0% {
		transform: translate(0, 0);
	}

	100% {
		transform: translate(0, calc(screenheight * 1.5));
	}
}
