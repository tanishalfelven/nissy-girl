.seed {
	composes: menu from "./main.mcss";
	display: flex;
	flex-direction: column;
	justify-content: space-around;
}

.prompt {
	composes: scorelabel from "./play-overlay/score.mcss";
	position: absolute;
	top: 5rem;
	font-size: 16rem;
}

.seednav {
	display: flex;
	flex-direction: row;
	margin-top: 5rem;
}

.seedindex {
	display: flex;
	flex-direction: column;
	margin: 0 2rem;
}

.button {
	composes: button from "./button.mcss";
	width: 10rem;
	margin-bottom: 0;
	color: rgb(255 255 255 / 70%);
}

.increment,
.decrement {
	display: flex;
	align-items: center;
	justify-content: center;

	color: rgb(255 255 255 / 40%);
	text-align: center;

	transition: color 100ms;

	&[data-bling="true"] {
		color: rgb(255 255 255 / 100%);
	}
}
