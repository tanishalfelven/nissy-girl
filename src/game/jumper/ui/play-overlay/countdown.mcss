@keyframes count {
	0% {
		transform: translate(-70%) scale(1);
		opacity: 0.2;
	}

	10% {
		transform: translate(0) scale(1.3);
		opacity: 1;
	}

	90% {
		transform: translate(0) scale(1.4);
		opacity: 1;
	}

	100% {
		transform: translate(70%) scale(1.2);
		opacity: 0.2;
	}
}

.count {
	composes: overlaytext from "./play-overlay.mcss";

	position: absolute;
	top: 5rem;

	width: 100%;

	font-size: 24rem;
	text-align: center;

	animation: count 1s linear 1;
	animation-fill-mode: both;
}
