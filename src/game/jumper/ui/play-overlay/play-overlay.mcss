@value spx, screenwidth from "$nissy-girl/screens/screens.mcss";

.game {
	composes: menu from "../main.mcss";
}

.overlaytext {
	color: #fff;
	text-shadow: 1px 1px 2px #000;
}

.timer {
	composes: fadein from "$util/animations.mcss";
	composes: overlaytext;

	position: absolute;
	top: 0;
	left: 43%;

	font-size: calc(12 * spx);
	text-align: left;

	opacity: 0.9;
}

.coins {
	composes: afterimg from "$util/util.mcss";
	composes: overlaytext;

	position: absolute;
	top: 0;
	right: calc(3 * spx);

	display: flex;
	flex-direction: row;
	align-items: center;

	font-size: calc(9 * spx);
	text-align: right;

	opacity: 0.8;

	&::after {
		content: "";

		display: block;

		width: calc(5 * spx);
		height: calc(6 * spx);
		margin-left: calc(1 * spx);

		background-image: url("./assets/coin.png");
	}
}

.seed {
	composes: overlaytext;

	position: absolute;
	top: 0;
	left: calc(3 * spx);

	font-size: calc(9 * spx);

	opacity: 0.5;
}
