@value spx, screenwidth from "$nissy-girl/screens/screens.mcss";

.game {
	composes: menu from "../menu.mcss";
}

.overlaytext {
	color: #fff;
	text-shadow: 1px 1px 2px #000;
}

.timer {
	composes: overlaytext;

	position: absolute;
	top: 0;
	left: calc(0.83 * screenwidth);

	font-size: calc(12 * spx);
	color: #d9d9d9;
	text-align: left;
}

.coins {
	composes: overlaytext;

	position: absolute;
	top: calc(11 * spx);
	right: calc(1.75 * spx);

	font-size: calc(10 * spx);
	color: #d9d9d9;
	text-align: right;
}
