@value spx from "$nissy-girl/screens/screens.mcss";

@keyframes count {
	0% {
		transform: translate(-70%) scale(1);
		opacity: 0.2;
	}

	10% {
		transform: translate(0) scale(1.3);
		opacity: 1;
	}

	90% {
		transform: translate(0) scale(1.4);
		opacity: 1;
	}

	100% {
		transform: translate(70%) scale(1.2);
		opacity: 0.2;
	}
}

.game {
	composes: menu from "../menu.mcss";
}

.count {
	position: absolute;
	top: calc(5 * spx);

	width: 100%;

	font-size: calc(24 * spx);
	color: #fff;
	text-align: center;
	text-shadow: 1px 1px 2px #000;

	animation: count 1s linear 1;
	animation-fill-mode: both;
}
