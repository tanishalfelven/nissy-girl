@value screenwidth from "$nissy-girl/screens/screens.mcss";

.game {
	composes: menu from "../main.mcss";
}

.overlaytext {
	color: #fff;
	text-shadow: 1px 1px 2px #000;
}

.timer {
	composes: fadein from "$util/animations.mcss";
	composes: overlaytext;

	position: absolute;
	top: 0;
	left: 43%;

	font-size: 12rem;
	text-align: left;

	opacity: 0.9;
}

.coins {
	composes: afterimg from "$util/util.mcss";
	composes: overlaytext;

	position: absolute;
	top: 0;
	right: 3rem;

	display: flex;
	flex-direction: row;
	align-items: center;

	font-size: 9rem;
	text-align: right;

	opacity: 0.8;

	&::after {
		content: "";

		display: block;

		width: 5rem;
		height: 6rem;
		margin-left: 1rem;

		background-image: url("./assets/coin.png");
	}
}

.seed {
	composes: overlaytext;

	position: absolute;
	top: 0;
	left: 3rem;

	font-size: 9rem;

	opacity: 0.5;
}
