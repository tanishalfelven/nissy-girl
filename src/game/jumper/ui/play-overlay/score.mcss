.scorecontainer {
	composes: fadein from "$util/animations.mcss";

	position: absolute;
	top: 15rem;

	display: flex;
	flex-direction: column;
	align-items: center;

	animation-duration: 80ms;
}

.score {
	display: flex;
	flex-direction: row;
	margin-bottom: 5rem;
}

.scorelabel {
	composes: overlaytext from "./play-overlay.mcss";
	composes: button from "../button.mcss";

	margin-right: 3rem;
	margin-bottom: 0;
	border-color: #006161;

	font-size: 23rem;
	color: #dcdcdc;

	background-color: #008080;
}

.scorevalue {
	composes: overlaytext from "./play-overlay.mcss";
	font-size: 28rem;
	color: #fff;
}

.scorenav {
	display: flex;
	flex-direction: column;
	justify-content: flex-end;

	margin-top: 5rem;
	margin-right: 60rem;
}

.button {
	composes: button from "../button.mcss";
}
