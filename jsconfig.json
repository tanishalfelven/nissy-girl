{
	"compilerOptions": {
		"moduleResolution": "bundler",
		"target": "ESNext",
		"module": "ESNext",
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"esModuleInterop": true,
		"types": [ "vite/client" ],
		"skipLibCheck": true,
		"checkJs": false,
		"paths": {
			"$game/*": ["./src/game/*"],
			"$util/*": ["./src/util/*"],
			"$nissy-girl/*": ["./src/nissy-girl/*"]
		}
	},
	"include": [
		"src/**/*.d.ts",
		"src/**/*.js",
		"src/**/*.svelte"
	]
}
